[Unit]
Description=AI Company Korean reading translation
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/ai-company/releases/control-plane
EnvironmentFile=%h/ai-company/runtime/control-plane/worker.env
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v22.13.0/bin:/usr/bin:/bin
Environment=LANGSMITH_TRACING=false
Environment=LANGCHAIN_TRACING_V2=false
ExecStart=%h/ai-company/releases/control-plane/.venv/bin/python -m ai_company.service_worker translation --state-dir ${AI_COMPANY_STATE} --config ${AI_COMPANY_TRANSLATION_CONFIG} --execute-translations --shared-call-ledger ${AI_COMPANY_SHARED_CALL_LEDGER}
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
