# Optional diagram-capable candidate. Existing production Dockerfile is preserved.
# Supply reviewed official images with compatible Debian Bookworm runtimes.
ARG NODE_IMAGE
ARG PYTHON_IMAGE
FROM ${NODE_IMAGE} AS diagram_node
FROM ${PYTHON_IMAGE}
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=never ARCHIFY_UPDATE_CHECK_DISABLED=1
COPY --from=diagram_node /usr/local/bin/node /usr/local/bin/node
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN node --version && python -m pip install --no-cache-dir uv==0.12.11 \
    && uv sync --frozen --no-dev --no-editable --python /usr/local/bin/python \
    && rm -rf /root/.cache
USER 65532:65532
ENTRYPOINT ["/app/.venv/bin/python", "-m", "ai_company.cli"]
